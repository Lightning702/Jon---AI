JON_APP_NAME=Jon
HOST=127.0.0.1
PORT=8756
# Leer lassen: Jon erlaubt dann genau die Adressen seiner eigenen Oberflaeche.
# Ein eigener Wert (kommagetrennt) ueberschreibt das. "*" ist moeglich, aber unsicher.
CORS_ORIGINS=
JON_LAN=0
# Der Online-Koop laeuft ueber eigene Ports (8760 Browser, 8759 ECHO/AETHERIA) und ist
# ohne JON_LAN im Netzwerk erreichbar. JON_LAN=1 oeffnet zusaetzlich den ganzen Rest.
# Seit 4.36.0 braucht jede /api/-Anfrage den Geraete-Schluessel aus data/access.token.
# Die Adresse zum Koppeln steht in Jon unter Zahnrad -> Diagnose & Handy koppeln.
# JON_TOKEN hier zu setzen ist nur noetig, wenn du den Schluessel selbst vorgeben willst.
JON_TOKEN=

DEFAULT_PROVIDER=nvidia
DEFAULT_JON_MODEL=openai/gpt-oss-120b
DEFAULT_EMIL_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low
# Zeichenbudget fuer den Gespraechsverlauf; aelteres wird zusammengefasst statt abgeschnitten.
CONTEXT_BUDGET_TOKENS=24000

OPENAI_API_KEY=
NVIDIA_API_KEY=erster-key-fuer-mini-jon-und-telegram, zweiter-key-fuer-jon
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
TOGETHER_BASE_URL=https://api.together.xyz/v1
XAI_BASE_URL=https://api.x.ai/v1
# Startwert fuer Ollama; danach zaehlt die Einstellung im Zahnrad-Menue (data/ollama.json)
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ---------------------------------------------------------------------------
# Jon Maps — alle Voreinstellungen sind kostenlos und brauchen keinen Schluessel.
# Jeder Anbieter ist austauschbar; leer lassen schaltet die jeweilige Ebene ab.
# ---------------------------------------------------------------------------
MAPS_GEOCODER=nominatim
MAPS_PLACES=overpass
MAPS_ROUTER=osrm
MAPS_TRANSIT=transitous
MAPS_STREET=kartaview
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
# Der oeffentliche OSRM-Demoserver kennt nur das Autoprofil. Wer selbst hostet,
# traegt hier z.B. auto,fahrrad,fuss ein; Rad und Fussweg laufen sonst ueber Valhalla.
OSRM_PROFILES=auto
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
TRANSITOUS_BASE_URL=https://api.transitous.org
KARTAVIEW_BASE_URL=https://api.openstreetcam.org
MAPS_STYLE_DARK=https://tiles.openfreemap.org/styles/positron
MAPS_STYLE_LIGHT=https://tiles.openfreemap.org/styles/bright
MAPS_TILES_SATELLITE=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAPS_TERRAIN_TILES=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
MAPS_TRANSIT_TILES=https://tileserver.memomaps.de/tilegen/{z}/{x}/{y}.png
MAPS_BIKE_TILES=https://a.tile-cyclosm.openstreetmap.fr/cyclosm/{z}/{x}/{y}.png
# Leer = keine Verkehrsebene. Es gibt keine kostenlose Quelle dafuer; wer eine hat,
# traegt hier die Kachel-URL ein, dann erscheint der Schalter in den Ebenen.
MAPS_TRAFFIC_TILES=
# Startpunkt, falls die grobe Ortung ueber die IP nicht klappt.
MAPS_HOME_LAT=51.1657
MAPS_HOME_LON=10.4515
MAPS_HOME_ZOOM=5.2
MAPS_USER_AGENT=JonDesktop/4.34 (+https://github.com/Lightning702/Jon)
# Optional: kostenloser Mapillary-Schluessel. Ohne ihn nutzt Jon KartaView, das
# gar keinen Schluessel braucht.
MAPILLARY_TOKEN=

# ---------------------------------------------------------------------------
# Jon Deep Learning — nutzt das Modell, das ohnehin in Jon eingestellt ist.
# ---------------------------------------------------------------------------
RESEARCH_SOURCES_PER_TOPIC=6
RESEARCH_MAX_SUBTOPICS=14
RESEARCH_PAGE_CHARS=14000
RESEARCH_DEFAULT_MINUTES=45

REQUEST_TIMEOUT=90
FIRST_TOKEN_TIMEOUT=10
MODELS_TIMEOUT=6
MAX_TOKENS=32768

{
  "appId": "io.jon.desktop",
  "productName": "Jon",
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraResources": [
    {
      "from": "../backend/dist/jon-backend",
      "to": "jon-backend",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../extension",
      "to": "extension",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../ECHO",
      "to": "ECHO",
      "filter": [
        "jon-spiele.json",
        "README.md",
        "bin/**/*",
        "shaders/**/*",
        "vorschau/**/*"
      ]
    },
    {
      "from": "../spiele/STARFALL",
      "to": "STARFALL",
      "filter": [
        "jon-spiele.json",
        "README.md",
        "docs/**/*",
        "bin/**/*",
        "!bin/*.log",
        "vorschau/**/*"
      ]
    },
    {
      "from": "../spiele/KATZENHOF",
      "to": "KATZENHOF",
      "filter": [
        "jon-spiele.json",
        "README.md"
      ]
    }
  ],
  "directories": {
    "output": "release"
  },
  "win": {
    "target": "nsis",
    "icon": "electron/icon.ico",
    "signtoolOptions": {
      "publisherName": "FelWorks"
    }
  },
  "nsis": {
    "artifactName": "Jon-Setup.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Jon",
    "runAfterFinish": true
  }
}
